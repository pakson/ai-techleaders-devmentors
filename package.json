{
  "name": "devmentor",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.17.0"
  },
  "scripts": {
    "dev": "npm run dev -w @devmentor/app --",
    "build": "npm run build -w @devmentor/app",
    "start": "npm run start -w @devmentor/app --",
    "lint": "eslint && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run --project unit --coverage --outputFile.junit=test-results/unit/junit.xml",
    "test:int": "vitest run --project int --outputFile.junit=test-results/int/junit.xml",
    "test:e2e": "vitest run --project e2e --outputFile.junit=test-results/e2e/junit.xml",
    "db:migration:create": "npm run migration:create -w @devmentor/db --",
    "db:migration:up": "npm run migration:up -w @devmentor/db",
    "db:migration:down": "npm run migration:down -w @devmentor/db",
    "db:migration:list": "npm run migration:list -w @devmentor/db"
  },
  "devDependencies": {
    "@effect/language-service": "^0.87.5",
    "@effect/vitest": "^4.0.5",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.5",
    "agent-browser": "^0.39.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.2",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
